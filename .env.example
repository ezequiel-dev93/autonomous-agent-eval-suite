# Credenciales de Google Gemini (Opcional - Modo Producción LLM)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelos para el Agente (Harness) y el Juez Auditor (Evals)
AGENT_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash

# Límite de seguridad del Loop ReAct para evitar bucles infinitos
MAX_REACT_STEPS=5

# Umbral mínimo de aprobación (Quality Gate CI/CD)
MIN_PASS_SCORE=0.80
